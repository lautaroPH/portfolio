---
import ExperienceItem from './ExperienceItem.astro';
import { t, type Lang } from '@/i18n/ui';

interface Props {
  lang: Lang;
}
const tr = t(Astro.props.lang);
---

<ol class="relative mt-16">
  {
    tr.experience.map((experience) => (
      <li class="">
        <ExperienceItem {...experience} seeMore={tr.seeMore} />
      </li>
    ))
  }
</ol>
