---
import { t, type Lang } from '@/i18n/ui';

interface Props {
  lang: Lang;
}
const tr = t(Astro.props.lang);
const currentYear = new Date().getFullYear();
---

<footer
  class="opacity-80 m-4 min-[375px]:pl-4 md:pl-0 mt-16 w-full mx-auto container lg:max-w-4xl md:max-w-2xl mb-10 flex justify-center"
>
  <div
    class="w-full max-w-screen-xl py-4 mx-auto rounded-lg md:flex md:items-center md:justify-between"
  >
    <span class="text-sm sm:text-center text-zinc-800/90 dark:text-zinc-200/90">
      © {currentYear}
      <a href={tr.home} class="hover:underline">Lautaro Perez Herrera</a>.
      {tr.footer} <a
        href="https://github.com/midudev"
        target="_blank"
        rel="noopener"
        class="hover:underline">midudev</a
      >.
    </span>
    <ul
      class="flex flex-wrap items-center mt-3 text-sm font-medium dark:text-white/90 sm:mt-0"
    >
      <li>
        <a href={`${tr.home}#about-me`} class="hover:underline me-4 md:me-6">{tr.nav.about}</a>
      </li>
      <li>
        <a
          href={`${tr.home}#contact`}
          class="hover:underline">{tr.nav.contact}</a
        >
      </li>
    </ul>
  </div>
</footer>
