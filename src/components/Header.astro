---
import ThemeToggle from './ThemeToggle.astro';
import { t, type Lang } from '@/i18n/ui';

interface Props {
  lang: Lang;
}
const tr = t(Astro.props.lang);

const navItems = [
  { title: tr.nav.experience, label: 'experience', url: `${tr.home}#experience` },
  { title: tr.nav.projects, label: 'projects', url: `${tr.home}#projects` },
  { title: tr.nav.skills, label: 'skills', url: `${tr.home}#skills`, desktopOnly: true },
  { title: tr.nav.about, label: 'about-me', url: `${tr.home}#about-me` },
  { title: tr.nav.contact, label: 'contact', url: `${tr.home}#contact` },
];
---

<header
  class="fixed top-0 z-10 flex items-center justify-center w-full mx-auto mt-2"
>
  <nav
    class="flex items-center justify-center px-2 sm:px-3 text-sm font-medium text-gray-600 rounded-full dark:text-gray-200"
  >
    {
      navItems.map((link) => (
        <a
          class={`relative ${link.desktopOnly ? 'hidden sm:block' : 'block'} px-1.5 sm:px-2 py-2 whitespace-nowrap text-xs sm:text-sm transition hover:text-blue-500 dark:hover:text-blue-500`}
          aria-label={link.label}
          href={link.url}
        >
          {link.title}
        </a>
      ))
    }
    <a
      href={tr.switchLang.href}
      title={tr.switchLang.title}
      hreflang={tr.switchLang.label.toLowerCase()}
      class="px-2 py-0.5 mx-1 text-xs font-semibold border rounded-full border-gray-400/60 hover:text-blue-500 hover:border-blue-500"
      >{tr.switchLang.label}</a
    >
    <ThemeToggle label={tr.theme} />
  </nav>
</header>

<script>
  document.addEventListener('astro:page-load', () => {
    const sections = document.querySelectorAll('section');
    const navItems = document.querySelectorAll('header nav a');

    const callback = (entries: any[]) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          navItems.forEach((item) => {
            if (item.getAttribute('aria-label') == entry.target.id) {
              item.classList.add('text-blue-500');
            } else {
              item.classList.remove('text-blue-500');
            }
          });
        }
      });
    };

    const observer = new IntersectionObserver(callback, {
      root: null,
      rootMargin: '0px',
      threshold: 0.3,
    });

    sections.forEach((section) => {
      observer.observe(section);
    });

    // Cleanup function
    document.onvisibilitychange = () => {
      if (document.visibilityState === 'hidden') {
        observer.disconnect();
      } else {
        sections.forEach((section) => {
          observer.observe(section);
        });
      }
    };
  });
</script>

<style>
  nav {
    animation: nav-shadown 1s linear both;
    animation-timeline: scroll();
    animation-range: 0 100px;
  }

  nav {
    @apply dark:bg-gray-800/90 bg-white/50;
  }

  @keyframes nav-shadown {
    0% {
      @apply dark:bg-gray-800/0 bg-white/0;
    }
    to {
      @apply shadow-lg ring-1 backdrop-blur ring-white/10;
    }
  }
</style>
